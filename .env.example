# Copy to .env and fill in - .env is gitignored, never commit real credentials.

# IBKR paper account. Only main_docker_gateway.py uses the login; with a desktop
# gateway you log in yourself.
TWS_USERNAME=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TWS_ACCOUNT=DU1234567

# Optional. Defaults below suit both gateways; set IB_HOST when the gateway runs
# elsewhere, e.g. on Windows reached from WSL.
# IB_HOST=127.0.0.1
# IB_PORT=4002
